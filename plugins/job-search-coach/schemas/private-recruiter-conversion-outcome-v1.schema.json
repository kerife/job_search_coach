{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/job-search-coach/private-recruiter-conversion-outcome-v1.schema.json",
  "title": "Private Recruiter Conversion Outcome v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "locale", "event_date", "event_type", "source_artifact_id", "source_version", "fact_ids", "observation_state", "next_safe_action", "delivery"],
  "properties": {
    "schema_version": {"const": "private-recruiter-conversion-outcome-v1"},
    "artifact_kind": {"const": "private_recruiter_conversion_outcome"},
    "locale": {"enum": ["en", "es"]},
    "event_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "event_type": {"enum": ["contact_received", "reply_received", "referral_received", "screen_requested", "interview_requested", "stop_decision"]},
    "source_artifact_id": {"type": "string", "pattern": "^D-[0-9]{3}$"},
    "source_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,31}$"},
    "fact_ids": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^F-[0-9]{3}$"}},
    "observation_state": {"const": "observed_candidate_reported"},
    "next_safe_action": {"enum": ["clarify_context_before_reply", "prepare_fact_checked_summary", "route_to_prepare-role-interviews", "record_stop_decision"]},
    "delivery": {"$ref": "#/$defs/delivery"}
  },
  "allOf": [
    {"if": {"properties": {"event_type": {"const": "contact_received"}}, "required": ["event_type"]}, "then": {"properties": {"next_safe_action": {"const": "clarify_context_before_reply"}}}},
    {"if": {"properties": {"event_type": {"const": "reply_received"}}, "required": ["event_type"]}, "then": {"properties": {"next_safe_action": {"const": "clarify_context_before_reply"}}}},
    {"if": {"properties": {"event_type": {"enum": ["referral_received"]}}, "required": ["event_type"]}, "then": {"properties": {"next_safe_action": {"const": "prepare_fact_checked_summary"}}}},
    {"if": {"properties": {"event_type": {"enum": ["screen_requested", "interview_requested"]}}, "required": ["event_type"]}, "then": {"properties": {"next_safe_action": {"const": "route_to_prepare-role-interviews"}}}},
    {"if": {"properties": {"event_type": {"const": "stop_decision"}}, "required": ["event_type"]}, "then": {"properties": {"next_safe_action": {"const": "record_stop_decision"}}}}
  ],
  "$defs": {"delivery": {"type": "object", "additionalProperties": false, "required": ["draft_only", "external_actions_authorized", "no_message_action", "no_calendar_action", "raw_event_retained", "local_save_mode"], "properties": {"draft_only": {"const": true}, "external_actions_authorized": {"const": false}, "no_message_action": {"const": true}, "no_calendar_action": {"const": true}, "raw_event_retained": {"const": false}, "local_save_mode": {"const": "disabled"}}}}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/job-search-coach/recruiter-practice-session-v1.schema.json",
  "title": "Private Recruiter Practice Session v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_kind", "locale", "state", "safe_context", "requirement", "question", "facts", "observed_answer", "rubric", "feedback", "delivery"],
  "properties": {
    "schema_version": {"const": "recruiter-practice-session-v1"},
    "session_kind": {"const": "private_recruiter_practice"},
    "locale": {"enum": ["es", "en"]},
    "state": {"enum": ["ready_to_practice", "awaiting_answer", "feedback_available"]},
    "safe_context": {"$ref": "#/$defs/safe_context"},
    "requirement": {"$ref": "#/$defs/requirement"},
    "question": {"$ref": "#/$defs/question"},
    "facts": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/fact"}},
    "observed_answer": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/observed_answer"}]},
    "rubric": {"$ref": "#/$defs/rubric"},
    "feedback": {"$ref": "#/$defs/feedback"},
    "delivery": {"$ref": "#/$defs/delivery"},
    "handoff_context": {"$ref": "#/$defs/handoff_context"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"enum": ["ready_to_practice", "awaiting_answer"]}}, "required": ["state"]},
      "then": {"properties": {"observed_answer": {"const": null}, "feedback": {"$ref": "#/$defs/pre_answer_feedback"}}}
    },
    {
      "if": {"properties": {"state": {"const": "feedback_available"}}, "required": ["state"]},
      "then": {"properties": {"observed_answer": {"$ref": "#/$defs/observed_answer"}, "feedback": {"allOf": [{"$ref": "#/$defs/feedback"}, {"properties": {"score_state": {"const": "categorical"}, "observations": {"minItems": 1}}}]}}}
    }
    ,{
      "if": {"properties": {"handoff_context": {"properties": {"source": {"const": "executive_career_dossier"}}}}, "required": ["handoff_context"]},
      "then": {"properties": {"handoff_context": {"required": ["claim_ids", "evidence_ids"]}}}
    },
    {
      "if": {"properties": {"handoff_context": {"properties": {"source": {"const": "executive_career_dossier"}}}}, "required": ["handoff_context"]},
      "then": {"properties": {"handoff_context": {"properties": {"source_snapshot": {"pattern": "^snap-dossier-[0-9]{3}$"}}}}}
    },
    {
      "if": {"properties": {"handoff_context": {"properties": {"source": {"const": "private_recruiter_reply_triage"}}}}, "required": ["handoff_context"]},
      "then": {"properties": {"handoff_context": {"properties": {"source_snapshot": {"pattern": "^snap-triage-[0-9]{3}$"}}}}}
    }
  ],
  "$defs": {
    "safe_context": {"type": "object", "additionalProperties": false, "required": ["stage", "vacancy_state", "summary"], "properties": {"stage": {"const": "recruiter_screen"}, "vacancy_state": {"const": "safe_summary_provided"}, "summary": {"type": "string", "minLength": 1, "maxLength": 280}}},
    "requirement": {"type": "object", "additionalProperties": false, "required": ["id", "summary", "fact_ids"], "properties": {"id": {"pattern": "^R-[0-9]{3}$"}, "summary": {"type": "string", "minLength": 1, "maxLength": 280}, "fact_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"pattern": "^F-[0-9]{3}$"}}}},
    "question": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "text", "requirement_id", "fact_ids"], "properties": {"id": {"pattern": "^Q-[0-9]{3}$"}, "kind": {"enum": ["screen_opening", "proof_example", "eligibility_boundary", "compensation_boundary", "missing_detail"]}, "text": {"type": "string", "minLength": 1, "maxLength": 500}, "requirement_id": {"pattern": "^R-[0-9]{3}$"}, "fact_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"pattern": "^F-[0-9]{3}$"}}}},
    "fact": {"type": "object", "additionalProperties": false, "required": ["id", "state", "summary"], "properties": {"id": {"pattern": "^F-[0-9]{3}$"}, "state": {"enum": ["verified", "candidate_reported"]}, "summary": {"type": "string", "minLength": 1, "maxLength": 500}}},
    "observed_answer": {"type": "object", "additionalProperties": false, "required": ["id", "text", "storage"], "properties": {"id": {"const": "OBS-001"}, "text": {"type": "string", "minLength": 1, "maxLength": 2000}, "storage": {"const": "ephemeral"}}},
    "rubric": {"type": "object", "additionalProperties": false, "required": ["id", "criterion"], "properties": {"id": {"const": "RB-001"}, "criterion": {"type": "string", "minLength": 1, "maxLength": 500}}},
    "feedback": {"type": "object", "additionalProperties": false, "required": ["score", "score_state", "observations"], "properties": {"score": {"const": "unknown"}, "score_state": {"enum": ["unknown", "categorical"]}, "observations": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/observation"}}}},
    "pre_answer_feedback": {"type": "object", "additionalProperties": false, "required": ["score", "score_state", "observations"], "properties": {"score": {"const": "unknown"}, "score_state": {"const": "unknown"}, "observations": {"type": "array", "maxItems": 0}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["label", "statement", "source_refs"], "properties": {"label": {"enum": ["solid", "confirm", "do_not_assert"]}, "statement": {"type": "string", "minLength": 1, "maxLength": 500}, "source_refs": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["OBS-001", "RB-001"]}}}},
    "delivery": {"type": "object", "additionalProperties": false, "required": ["draft_only", "external_actions_authorized", "local_save_mode", "raw_answer_retained"], "properties": {"draft_only": {"const": true}, "external_actions_authorized": {"const": false}, "local_save_mode": {"const": "disabled"}, "raw_answer_retained": {"const": false}}},
    "handoff_context": {"type": "object", "additionalProperties": false, "required": ["source", "source_snapshot", "question_rank", "question_id", "requirement_id", "fact_ids", "draft_only", "external_actions_authorized"], "properties": {"source": {"enum": ["executive_career_dossier", "private_recruiter_reply_triage"]}, "source_snapshot": {"pattern": "^snap-(?:dossier|triage)-[0-9]{3}$"}, "question_rank": {"const": 1}, "question_id": {"pattern": "^Q-[0-9]{3}$"}, "requirement_id": {"pattern": "^R-[0-9]{3}$"}, "fact_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"pattern": "^F-[0-9]{3}$"}}, "claim_ids": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"pattern": "^C-[0-9]{3}$"}}, "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"pattern": "^E-[0-9]{3}$"}}, "draft_only": {"const": true}, "external_actions_authorized": {"const": false}}}
  }
}

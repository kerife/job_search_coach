{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Identity-free target vacancy research v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "research_kind", "evidence_mode", "locale", "as_of_date", "search_scope", "state", "search_limit", "employers", "vacancies", "privacy_boundary", "no_external_action"],
  "properties": {
    "schema_version": {"const": "target-vacancy-research-v1"},
    "research_kind": {"const": "sre_platform_devops_current_vacancies"},
    "evidence_mode": {"enum": ["synthetic", "live"]},
    "locale": {"enum": ["es", "en"]},
    "as_of_date": {"type": "string", "format": "date"},
    "search_scope": {"$ref": "#/$defs/search_scope"},
    "state": {"enum": ["complete", "limited_market_evidence", "market_evidence_unavailable"]},
    "search_limit": {"$ref": "#/$defs/search_limit"},
    "employers": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/employer"}},
    "vacancies": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/vacancy"}},
    "privacy_boundary": {"const": "public_vacancy_sources_and_identity_free_candidate_evidence_only"},
    "no_external_action": {"const": true}
  },
  "$defs": {
    "search_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["geography_scope", "target_role_families", "maximum_vacancies", "distinct_employers_preferred", "official_sources_first", "linkedin_jobs_backup_allowed", "no_eligibility_inference"],
      "properties": {
        "geography_scope": {"const": "mexico_or_stated_remote"},
        "target_role_families": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["site_reliability_engineering", "platform_engineering", "devops_engineering"]}},
        "maximum_vacancies": {"const": 5},
        "distinct_employers_preferred": {"const": true},
        "official_sources_first": {"const": true},
        "linkedin_jobs_backup_allowed": {"const": true},
        "no_eligibility_inference": {"const": true}
      }
    },
    "search_limit": {
      "type": "object", "additionalProperties": false,
      "required": ["bounded_queries_run", "limit_reason", "distinct_employer_search_exhausted", "limitation"],
      "properties": {
        "bounded_queries_run": {"type": "integer", "minimum": 0, "maximum": 100},
        "limit_reason": {"enum": ["target_reached", "search_limit_reached", "source_limit", "none"]},
        "distinct_employer_search_exhausted": {"type": "boolean"},
        "limitation": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "employer": {
      "type": "object", "additionalProperties": false,
      "required": ["employer_id", "display_name", "qualification_type", "qualification_observation", "official_source_title", "official_source_url", "source_date", "access_date"],
      "properties": {
        "employer_id": {"type": "string", "pattern": "^EMP-[0-9]{3}$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "qualification_type": {"enum": ["official_headcount", "official_index_membership"]},
        "qualification_observation": {"type": "string", "minLength": 1, "maxLength": 500},
        "official_source_title": {"type": "string", "minLength": 1, "maxLength": 240},
        "official_source_url": {"type": "string", "pattern": "^https://"},
        "source_date": {"type": "string", "format": "date"},
        "access_date": {"type": "string", "format": "date"}
      }
    },
    "vacancy": {
      "type": "object", "additionalProperties": false,
      "required": ["vacancy_id", "duplicate_fingerprint", "employer_id", "title", "role_family", "location", "arrangement", "geographic_compatibility", "source_kind", "source_url", "official_referrer_url", "source_state", "access_date", "publication_date", "freshness_status", "eligibility_gates", "requirements"],
      "properties": {
        "vacancy_id": {"type": "string", "pattern": "^V-[0-9]{3}$"},
        "duplicate_fingerprint": {"type": "string", "pattern": "^[a-z0-9-]{3,120}$"},
        "employer_id": {"type": "string", "pattern": "^EMP-[0-9]{3}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 240},
        "role_family": {"enum": ["site_reliability_engineering", "platform_engineering", "devops_engineering"]},
        "location": {"type": "string", "minLength": 1, "maxLength": 160},
        "arrangement": {"enum": ["onsite", "hybrid", "remote", "flexible"]},
        "geographic_compatibility": {"enum": ["explicit_mexico", "stated_remote_unknown_eligibility"]},
        "source_kind": {"enum": ["official_employer", "employer_operated_ats", "linkedin_jobs_backup"]},
        "source_url": {"type": "string", "pattern": "^https://"},
        "official_referrer_url": {"type": ["string", "null"], "pattern": "^https://"},
        "source_state": {"const": "active"},
        "access_date": {"type": "string", "format": "date"},
        "publication_date": {"type": ["string", "null"], "format": "date"},
        "freshness_status": {"enum": ["current", "unknown"]},
        "eligibility_gates": {"type": "array", "minItems": 1, "maxItems": 7, "items": {"$ref": "#/$defs/gate"}},
        "requirements": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"$ref": "#/$defs/requirement"}}
      },
      "oneOf": [
        {"properties": {"publication_date": {"type": "null"}, "freshness_status": {"const": "unknown"}}},
        {"properties": {"publication_date": {"type": "string"}, "freshness_status": {"enum": ["current", "unknown"]}}}
      ]
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["gate", "state", "observed_condition"],
      "properties": {
        "gate": {"enum": ["work_authorization", "country_geography", "work_arrangement", "language", "seniority", "experience_floor", "employment_arrangement"]},
        "state": {"enum": ["pass", "blocked", "unknown"]},
        "observed_condition": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement_id", "signal", "importance", "source_paraphrase"],
      "properties": {
        "requirement_id": {"type": "string", "pattern": "^V-[0-9]{3}-R-[0-9]{2}$"},
        "signal": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
        "importance": {"enum": ["must_have", "preferred", "responsibility_only"]},
        "source_paraphrase": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/professional-growth-coach/private-recruiter-followthrough-checkpoint-v1.schema.json",
  "title": "Private Recruiter Follow-through Checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "locale", "source_receipt", "action_state", "observed_date", "next_measurement_event", "next_safe_action", "delivery"],
  "properties": {
    "schema_version": {"const": "private-recruiter-followthrough-checkpoint-v1"},
    "artifact_kind": {"const": "private_recruiter_followthrough_checkpoint"},
    "locale": {"enum": ["en", "es"]},
    "source_receipt": {"$ref": "#/$defs/source_receipt"},
    "target_binding": {"$ref": "#/$defs/target_binding"},
    "action_state": {"enum": ["accepted", "deferred", "declined", "completed"]},
    "observed_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "next_measurement_event": {"enum": ["screen_prepared", "screen_attended", "interview_requested", "stop_decision", "unknown"]},
    "next_safe_action": {"enum": ["manual_reenter_private_prep", "clarify_context_before_reply", "debrief_after_screen", "record_stop_decision", "route_to_prepare-role-interviews"]},
    "delivery": {"$ref": "#/$defs/delivery"}
  },
  "allOf": [
    {"if": {"properties": {"action_state": {"const": "accepted"}}, "required": ["action_state"]}, "then": {"properties": {"next_measurement_event": {"const": "unknown"}, "next_safe_action": {"const": "manual_reenter_private_prep"}}}},
    {"if": {"properties": {"action_state": {"const": "deferred"}}, "required": ["action_state"]}, "then": {"properties": {"next_measurement_event": {"const": "unknown"}, "next_safe_action": {"const": "clarify_context_before_reply"}}}},
    {"if": {"properties": {"action_state": {"const": "declined"}}, "required": ["action_state"]}, "then": {"properties": {"next_measurement_event": {"const": "unknown"}, "next_safe_action": {"const": "record_stop_decision"}}}},
    {"if": {"properties": {"action_state": {"const": "completed"}, "next_measurement_event": {"enum": ["screen_prepared", "interview_requested"]}}, "required": ["action_state", "next_measurement_event"]}, "then": {"properties": {"next_safe_action": {"const": "route_to_prepare-role-interviews"}}}},
    {"if": {"properties": {"action_state": {"const": "completed"}, "next_measurement_event": {"const": "stop_decision"}}, "required": ["action_state", "next_measurement_event"]}, "then": {"properties": {"next_safe_action": {"const": "record_stop_decision"}}}},
    {"if": {"properties": {"action_state": {"const": "completed"}, "next_measurement_event": {"const": "screen_attended"}}, "required": ["action_state", "next_measurement_event"]}, "then": {"properties": {"next_safe_action": {"const": "debrief_after_screen"}}}},
    {"if": {"properties": {"action_state": {"const": "completed"}, "next_measurement_event": {"const": "unknown"}}, "required": ["action_state", "next_measurement_event"]}, "then": {"properties": {"next_safe_action": {"const": "clarify_context_before_reply"}}}}
    ,{"if": {"properties": {"next_measurement_event": {"const": "screen_attended"}}, "required": ["next_measurement_event"]}, "then": {"required": ["target_binding"]}}
  ],
  "$defs": {
    "target_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "source_gate_snapshot"],
      "properties": {
        "target_id": {"type": "string", "pattern": "^T-[0-9]{3}$"},
        "source_gate_snapshot": {"type": "string", "pattern": "^snap-shortlist-sha256-[0-9a-f]{64}$"}
      }
    },
    "source_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_version", "event_type"],
      "properties": {
        "id": {"type": "string", "pattern": "^D-[0-9]{3}$"},
        "source_version": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,31}$"},
        "event_type": {"enum": ["contact_received", "reply_received", "referral_received", "screen_requested", "interview_requested", "stop_decision"]}
      }
    },
    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["draft_only", "external_actions_authorized", "no_message_action", "no_calendar_action", "raw_event_retained", "local_save_mode"],
      "properties": {
        "draft_only": {"const": true}, "external_actions_authorized": {"const": false}, "no_message_action": {"const": true}, "no_calendar_action": {"const": true},
        "raw_event_retained": {"const": false}, "local_save_mode": {"const": "disabled"}
      }
    }
  }
}

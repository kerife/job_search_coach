    {"if": {"properties": {"source_intake": {"properties": {"intake": {"properties": {"stated_stage": {"const": "take_home"}}}}}}, "required": ["source_intake"]}, "then": {"properties": {"next_stage": {"enum": ["technical_deep_dive", "system_design", "panel", "offer_stage"]}}}},

    "source_gate": {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_kind", "locale", "as_of_date", "source_shortlist", "source_snapshot", "decision_counts", "decision_rows", "screen_context", "handoff", "delivery"], "properties": {"schema_version": {"const": "recruiter-target-decision-gate-v1"}, "artifact_kind": {"const": "private_recruiter_target_decision_gate"}, "locale": {"enum": ["es", "en"]}, "as_of_date": {"type": "string", "format": "date"}, "source_shortlist": {"type": "object", "minProperties": 9}, "source_snapshot": {"type": "string", "pattern": "^snap-shortlist-sha256-[0-9a-f]{64}$"}, "decision_counts": {"type": "object", "minProperties": 4}, "decision_rows": {"type": "array", "minItems": 3, "maxItems": 6}, "screen_context": {"type": ["object", "null"]}, "handoff": {"type": "object", "minProperties": 8}, "delivery": {"type": "object", "minProperties": 4}}}

    {"if": {"properties": {"review_state": {"const": "blocked"}}, "required": ["review_state"]}, "then": {"properties": {"handoff": {"properties": {"next_safe_action": {"enum": ["collect_debrief_context", "record_stop_decision"]}}}}}},
    {"if": {"properties": {"source_intake": {"properties": {"intake": {"properties": {"stated_stage": {"const": "recruiter_screen"}}}}}}, "required": ["source_intake"]}, "then": {"properties": {"next_stage": {"enum": ["first_interview", "technical_screen"]}}}},
    {"if": {"properties": {"source_intake": {"properties": {"intake": {"properties": {"stated_stage": {"const": "first_interview"}}}}}}, "required": ["source_intake"]}, "then": {"properties": {"next_stage": {"enum": ["technical_screen", "hiring_manager", "technical_deep_dive", "take_home", "system_design", "behavioral_loop", "panel"]}}}},
    {"if": {"properties": {"source_intake": {"properties": {"intake": {"properties": {"stated_stage": {"const": "technical_screen"}}}}}}, "required": ["source_intake"]}, "then": {"properties": {"next_stage": {"enum": ["hiring_manager", "technical_deep_dive", "take_home", "system_design", "behavioral_loop", "panel"]}}}},
    {"if": {"properties": {"source_intake": {"properties": {"intake": {"properties": {"stated_stage": {"const": "hiring_manager"}}}}}}, "required": ["source_intake"]}, "then": {"properties": {"next_stage": {"enum": ["technical_deep_dive", "panel", "offer_stage"]}}}},

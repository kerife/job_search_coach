    {"if": {"properties": {"source_intake": {"properties": {"intake": {"properties": {"stated_stage": {"const": "behavioral_loop"}}}}}}, "required": ["source_intake"]}, "then": {"properties": {"next_stage": {"enum": ["panel", "offer_stage"]}}}},
    {"if": {"properties": {"source_intake": {"properties": {"intake": {"properties": {"stated_stage": {"const": "panel"}}}}}}, "required": ["source_intake"]}, "then": {"properties": {"next_stage": {"const": "offer_stage"}}}}
    ,{"if": {"properties": {"source_debrief": {"properties": {"decision": {"const": "stop"}}}}, "required": ["source_debrief"]}, "then": {"properties": {"review_state": {"const": "blocked"}, "handoff": {"properties": {"next_safe_action": {"const": "record_stop_decision"}}}}}}
    ,{"if": {"properties": {"source_debrief": {"properties": {"decision": {"const": "pause"}}}}, "required": ["source_debrief"]}, "then": {"properties": {"review_state": {"const": "blocked"}, "handoff": {"properties": {"next_safe_action": {"const": "collect_debrief_context"}}}}}}
    ,{"if": {"properties": {"handoff": {"properties": {"next_safe_action": {"const": "record_stop_decision"}}}}, "required": ["handoff"]}, "then": {"properties": {"source_debrief": {"properties": {"decision": {"const": "stop"}}}}}}
    ,{"if": {"properties": {"handoff": {"properties": {"next_safe_action": {"const": "collect_debrief_context"}}}}, "required": ["handoff"]}, "then": {"properties": {"source_debrief": {"properties": {"decision": {"enum": ["continue_review", "pause"]}}}}}}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/professional-growth-coach/recruiter-target-decision-gate-v1.schema.json",
  "title": "Private recruiter target decision gate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "locale", "as_of_date", "source_shortlist", "source_snapshot", "decision_counts", "decision_rows", "screen_context", "handoff", "delivery"],
  "properties": {
    "schema_version": {"const": "recruiter-target-decision-gate-v1"},
    "artifact_kind": {"const": "private_recruiter_target_decision_gate"},
    "locale": {"enum": ["es", "en"]},
    "as_of_date": {"type": "string", "format": "date"},
    "source_shortlist": {"$ref": "#/$defs/source_shortlist"},
    "source_snapshot": {"type": "string", "pattern": "^snap-shortlist-sha256-[0-9a-f]{64}$"},
    "decision_counts": {"type": "object", "additionalProperties": false, "required": ["advance", "clarify", "pause", "stop"], "properties": {"advance": {"type": "integer", "minimum": 0}, "clarify": {"type": "integer", "minimum": 0}, "pause": {"type": "integer", "minimum": 0}, "stop": {"type": "integer", "minimum": 0}}},
    "decision_rows": {"type": "array", "minItems": 3, "maxItems": 6, "items": {"$ref": "#/$defs/decision_row"}},
    "screen_context": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/screen_context"}]},
    "handoff": {"$ref": "#/$defs/handoff"},
    "delivery": {"$ref": "#/$defs/delivery"}
  },
  "$defs": {
    "source_shortlist": {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_kind", "locale", "as_of_date", "network_plan", "targets", "batch_decision", "top_priority_target_id", "delivery"], "properties": {
      "schema_version": {"const": "recruiter-target-shortlist-v1"},
      "artifact_kind": {"const": "private_recruiter_target_shortlist"},
      "locale": {"enum": ["es", "en"]},
      "as_of_date": {"type": "string", "format": "date"},
      "network_plan": {"$ref": "#/$defs/source_network_plan"},
      "targets": {"type": "array", "minItems": 3, "maxItems": 6, "items": {"$ref": "#/$defs/source_target"}},
      "batch_decision": {"enum": ["advance", "clarify", "pause", "stop"]},
      "top_priority_target_id": {"type": "string", "pattern": "^T-[0-9]{3}$"},
      "delivery": {"$ref": "#/$defs/source_shortlist_delivery"}
    }},
    "decision_row": {"type": "object", "additionalProperties": false, "required": ["target_id", "decision", "decision_reason", "contactability_status", "missing_context", "recommended_draft_type", "first_contact_strategy", "warm_intro_readiness", "next_safe_action", "draft_only", "consent", "authorization_required", "no_message_action", "no_calendar_action"], "properties": {
      "target_id": {"type": "string", "pattern": "^T-[0-9]{3}$"},
      "decision": {"enum": ["advance", "clarify", "pause", "stop"]},
      "decision_reason": {"type": "string", "minLength": 1, "maxLength": 300},
      "contactability_status": {"enum": ["contactable", "context_needed", "do_not_contact"]},
      "missing_context": {"type": "string", "minLength": 1, "maxLength": 300},
      "recommended_draft_type": {"enum": ["connection_note", "recruiter_interest", "referral_request", "none"]},
      "first_contact_strategy": {"type": "string", "minLength": 1, "maxLength": 300},
      "warm_intro_readiness": {"type": "string", "minLength": 1, "maxLength": 240},
      "next_safe_action": {"enum": ["draft_only_review", "collect_recipient_context", "record_observation_only"]},
      "draft_only": {"const": true}, "consent": {"const": "not_granted"}, "authorization_required": {"const": true}, "no_message_action": {"const": true}, "no_calendar_action": {"const": true}
    }},
    "screen_context": {"type": "object", "additionalProperties": false, "required": ["vacancy_summary", "confirmed_fact_summary"], "properties": {"vacancy_summary": {"type": "string", "minLength": 1, "maxLength": 280}, "confirmed_fact_summary": {"type": "string", "minLength": 1, "maxLength": 280}}},
    "handoff": {"type": "object", "additionalProperties": false, "required": ["screen_context_state", "next_safe_action", "manual_review_required", "selected_module", "draft_only", "external_actions_authorized", "no_message_action", "no_calendar_action"], "properties": {"screen_context_state": {"enum": ["missing", "provided"]}, "next_safe_action": {"enum": ["collect_screen_context", "prepare_role_interviews_review"]}, "manual_review_required": {"const": true}, "selected_module": {"const": "prepare-role-interviews"}, "draft_only": {"const": true}, "external_actions_authorized": {"const": false}, "no_message_action": {"const": true}, "no_calendar_action": {"const": true}}},
    "delivery": {"type": "object", "additionalProperties": false, "required": ["draft_only", "external_actions_authorized", "local_save_mode", "raw_contact_details_retained"], "properties": {"draft_only": {"const": true}, "external_actions_authorized": {"const": false}, "local_save_mode": {"const": "disabled"}, "raw_contact_details_retained": {"const": false}}},
    "source_network_plan": {"type": "object", "additionalProperties": false, "required": ["network_goal", "target_segments", "source_queries", "warm_path_first", "context_quality_gate", "outreach_batch_limit", "candidate_time_budget", "stop_condition"], "properties": {"network_goal": {"type": "string", "minLength": 1, "maxLength": 500}, "target_segments": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 80}}, "source_queries": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 180}}, "warm_path_first": {"const": true}, "context_quality_gate": {"type": "string", "minLength": 1, "maxLength": 500}, "outreach_batch_limit": {"type": "integer", "minimum": 1, "maximum": 6}, "candidate_time_budget": {"type": "string", "minLength": 1, "maxLength": 500}, "stop_condition": {"type": "string", "minLength": 1, "maxLength": 500}}},
    "source_target": {"type": "object", "additionalProperties": false, "required": ["target_id", "target_label", "contact_category", "company_or_specialty", "context_source", "context_state", "relationship_warmth", "target_theme", "supported_fact_ids", "missing_context", "priority_score", "decision", "decision_reason", "personalization_trigger", "recommended_draft_type", "contactability_status", "do_not_contact_reason", "next_safe_action", "draft_only", "consent", "authorization_required", "no_message_action", "no_calendar_action"], "properties": {"target_id": {"type": "string", "pattern": "^T-[0-9]{3}$"}, "target_label": {"type": "string", "minLength": 1, "maxLength": 160}, "contact_category": {"enum": ["warm_referral", "named_recruiter", "alumni", "community_contact", "technical_peer"]}, "company_or_specialty": {"type": "string", "minLength": 1, "maxLength": 160}, "context_source": {"type": "string", "minLength": 1, "maxLength": 300}, "context_state": {"enum": ["named_context", "context_needed", "do_not_contact"]}, "relationship_warmth": {"enum": ["warm", "cold_contextual", "unknown"]}, "target_theme": {"type": "string", "minLength": 1, "maxLength": 240}, "supported_fact_ids": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "pattern": "^F-[0-9]{3}$"}}, "missing_context": {"type": "string", "minLength": 1, "maxLength": 300}, "priority_score": {"type": "integer", "minimum": 0, "maximum": 100}, "decision": {"enum": ["advance", "clarify", "pause", "stop"]}, "decision_reason": {"type": "string", "minLength": 1, "maxLength": 300}, "personalization_trigger": {"type": "string", "minLength": 1, "maxLength": 240}, "recommended_draft_type": {"enum": ["connection_note", "recruiter_interest", "referral_request", "none"]}, "contactability_status": {"enum": ["contactable", "context_needed", "do_not_contact"]}, "do_not_contact_reason": {"enum": ["none", "no_context", "missing_context", "no_consent", "confidentiality_risk", "unsupported_claim", "closed_role", "missing_authorization"]}, "next_safe_action": {"enum": ["collect_recipient_context", "draft_only_review", "record_observation_only"]}, "draft_only": {"const": true}, "consent": {"const": "not_granted"}, "authorization_required": {"const": true}, "no_message_action": {"const": true}, "no_calendar_action": {"const": true}}},
    "source_shortlist_delivery": {"type": "object", "additionalProperties": false, "required": ["draft_only", "consent", "authorization_required", "no_message_action", "no_calendar_action", "raw_contact_details_retained", "local_save_mode"], "properties": {"draft_only": {"const": true}, "consent": {"const": "not_granted"}, "authorization_required": {"const": true}, "no_message_action": {"const": true}, "no_calendar_action": {"const": true}, "raw_contact_details_retained": {"const": false}, "local_save_mode": {"const": "disabled"}}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Career market learning dossier v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "locale", "as_of_date", "state", "source_research_snapshot", "source_executive_dossier_snapshot", "search_summary", "vacancy_cards", "matrix_rows", "recurrence_rows", "learning_state", "learning_decisions", "methodology_boundary", "privacy_boundary", "no_external_action"],
  "properties": {
    "schema_version": {"const": "career-market-learning-dossier-v1"},
    "locale": {"enum": ["es", "en"]},
    "as_of_date": {"type": "string", "format": "date"},
    "state": {"enum": ["complete", "limited_market_evidence", "market_evidence_unavailable"]},
    "source_research_snapshot": {"type": "string", "pattern": "^snap-market-sha256-[0-9a-f]{64}$"},
    "source_executive_dossier_snapshot": {"type": "string", "pattern": "^snap-dossier-sha256-[0-9a-f]{64}$"},
    "search_summary": {"$ref": "#/$defs/search_summary"},
    "vacancy_cards": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/card"}},
    "matrix_rows": {"type": "array", "maxItems": 150, "items": {"$ref": "#/$defs/matrix_row"}},
    "recurrence_rows": {"type": "array", "maxItems": 150, "items": {"$ref": "#/$defs/recurrence_row"}},
    "learning_state": {"const": "not_evaluated"},
    "learning_decisions": {"type": "array", "maxItems": 0},
    "methodology_boundary": {"const": "sample_based_documented_evidence_only_no_hiring_fit"},
    "privacy_boundary": {"const": "identity_free_evidence_references_only"},
    "no_external_action": {"const": true}
  },
  "$defs": {
    "search_summary": {"type": "object", "additionalProperties": false, "required": ["vacancy_sample_count", "bounded_queries_run", "limit_reason", "limitation"], "properties": {"vacancy_sample_count": {"type": "integer", "minimum": 0, "maximum": 5}, "bounded_queries_run": {"type": "integer", "minimum": 0, "maximum": 100}, "limit_reason": {"enum": ["target_reached", "search_limit_reached", "source_limit", "none"]}, "limitation": {"type": "string", "minLength": 1, "maxLength": 500}}},
    "requirement": {"type": "object", "additionalProperties": false, "required": ["requirement_id", "signal", "importance"], "properties": {"requirement_id": {"type": "string", "pattern": "^V-[0-9]{3}-R-[0-9]{2}$"}, "signal": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}, "importance": {"enum": ["must_have", "preferred", "responsibility_only"]}}},
    "card": {"type": "object", "additionalProperties": false, "required": ["vacancy_id", "employer_name", "title", "location", "arrangement", "source_kind", "source_url", "requirements", "earned_points", "maximum_points", "known_points", "alignment_percent", "evidence_coverage_percent", "interpretation", "qualitative_band"], "properties": {"vacancy_id": {"type": "string", "pattern": "^V-[0-9]{3}$"}, "employer_name": {"type": "string", "minLength": 1, "maxLength": 160}, "title": {"type": "string", "minLength": 1, "maxLength": 240}, "location": {"type": "string", "minLength": 1, "maxLength": 160}, "arrangement": {"enum": ["onsite", "hybrid", "remote", "flexible"]}, "source_kind": {"enum": ["official_employer", "employer_operated_ats", "linkedin_jobs_backup"]}, "source_url": {"type": "string", "pattern": "^https://"}, "requirements": {"type": "array", "minItems": 1, "maxItems": 30, "items": {"$ref": "#/$defs/requirement"}}, "earned_points": {"type": "integer", "minimum": 0}, "maximum_points": {"type": "integer", "minimum": 0}, "known_points": {"type": "integer", "minimum": 0}, "alignment_percent": {"type": "integer", "minimum": 0, "maximum": 100}, "evidence_coverage_percent": {"type": "integer", "minimum": 0, "maximum": 100}, "interpretation": {"const": "directional_documented_evidence_not_hiring_fit"}, "qualitative_band": {"enum": ["insufficient_evidence", "higher_documented_alignment", "moderate_documented_alignment", "lower_documented_alignment"]}}},
    "matrix_cell": {"type": "object", "additionalProperties": false, "required": ["vacancy_id", "required"], "properties": {"vacancy_id": {"type": "string", "pattern": "^V-[0-9]{3}$"}, "required": {"type": "boolean"}}},
    "matrix_row": {"type": "object", "additionalProperties": false, "required": ["signal", "support_state", "evidence_ids", "cells"], "properties": {"signal": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}, "support_state": {"enum": ["verified_match", "candidate_reported_match", "adjacent_evidence", "explicit_gap", "unknown"]}, "evidence_ids": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^E-[0-9]{3}$"}}, "cells": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/matrix_cell"}}}},
    "recurrence_row": {"type": "object", "additionalProperties": false, "required": ["signal", "occurrences", "sample_size", "display_fraction", "support_state", "evidence_ids"], "properties": {"signal": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}, "occurrences": {"type": "integer", "minimum": 1, "maximum": 5}, "sample_size": {"type": "integer", "minimum": 1, "maximum": 5}, "display_fraction": {"type": "string", "pattern": "^[1-5]/[1-5]$"}, "support_state": {"enum": ["verified_match", "candidate_reported_match", "adjacent_evidence", "explicit_gap", "unknown"]}, "evidence_ids": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "pattern": "^E-[0-9]{3}$"}}}}
  }
}

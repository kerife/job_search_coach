{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/professional-growth-coach/private-recruiter-triage-practice-handoff-v2.schema.json",
  "title": "Private Recruiter Triage Practice Handoff v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_artifact_kind", "source_snapshot", "projection_snapshot", "prep_scope", "practice_session", "delivery"],
  "properties": {
    "schema_version": {"const": "private-recruiter-triage-practice-handoff-v2"},
    "source_artifact_kind": {"const": "private_recruiter_reply_triage"},
    "source_snapshot": {"type": "string", "pattern": "^snap-triage-sha256-[0-9a-f]{64}$"},
    "projection_snapshot": {"type": "string", "pattern": "^snap-practice-sha256-[0-9a-f]{64}$"},
    "prep_scope": {"enum": ["screen_opening", "proof_example", "eligibility_boundary", "compensation_boundary", "missing_detail"]},
    "practice_session": {"$ref": "#/$defs/practice_session"},
    "delivery": {"$ref": "#/$defs/delivery"}
  },
  "$defs": {
    "practice_session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "session_kind", "ui_locale", "content_locale", "state", "safe_context", "requirement", "question", "facts", "observed_answer", "rubric", "feedback", "delivery", "handoff_context"],
      "properties": {
        "schema_version": {"const": "recruiter-practice-session-v2"},
        "session_kind": {"const": "private_recruiter_practice"},
        "ui_locale": {"enum": ["es", "en"]},
        "content_locale": {"enum": ["es", "en"]},
        "state": {"const": "ready_to_practice"},
        "safe_context": {"$ref": "#/$defs/safe_context"},
        "requirement": {"$ref": "#/$defs/requirement"},
        "question": {"$ref": "#/$defs/question"},
        "facts": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/fact"}},
        "observed_answer": {"type": "null"},
        "rubric": {"$ref": "#/$defs/rubric"},
        "feedback": {"$ref": "#/$defs/feedback"},
        "delivery": {"$ref": "#/$defs/practice_delivery"},
        "handoff_context": {"$ref": "#/$defs/handoff_context"}
      }
    },
    "safe_context": {"type": "object", "additionalProperties": false, "required": ["stage", "vacancy_state", "summary"], "properties": {"stage": {"const": "recruiter_screen"}, "vacancy_state": {"const": "safe_summary_provided"}, "summary": {"type": "string", "minLength": 1, "maxLength": 280}}},
    "requirement": {"type": "object", "additionalProperties": false, "required": ["id", "summary", "fact_ids"], "properties": {"id": {"const": "R-001"}, "summary": {"type": "string", "minLength": 1, "maxLength": 280}, "fact_ids": {"$ref": "#/$defs/fact_ids"}}},
    "question": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "text", "requirement_id", "fact_ids"], "properties": {"id": {"const": "Q-001"}, "kind": {"enum": ["screen_opening", "proof_example", "eligibility_boundary", "compensation_boundary", "missing_detail"]}, "text": {"type": "string", "minLength": 1, "maxLength": 500}, "requirement_id": {"const": "R-001"}, "fact_ids": {"$ref": "#/$defs/fact_ids"}}},
    "fact": {"type": "object", "additionalProperties": false, "required": ["id", "state", "summary"], "properties": {"id": {"const": "F-001"}, "state": {"const": "verified"}, "summary": {"type": "string", "minLength": 1, "maxLength": 500}}},
    "rubric": {"type": "object", "additionalProperties": false, "required": ["id", "criterion"], "properties": {"id": {"const": "RB-001"}, "criterion": {"type": "string", "minLength": 1, "maxLength": 500}}},
    "feedback": {"type": "object", "additionalProperties": false, "required": ["score", "score_state", "observations"], "properties": {"score": {"const": "unknown"}, "score_state": {"const": "unknown"}, "observations": {"type": "array", "maxItems": 0}}},
    "practice_delivery": {"type": "object", "additionalProperties": false, "required": ["draft_only", "external_actions_authorized", "local_save_mode", "raw_answer_retained"], "properties": {"draft_only": {"const": true}, "external_actions_authorized": {"const": false}, "local_save_mode": {"const": "disabled"}, "raw_answer_retained": {"const": false}}},
    "handoff_context": {"type": "object", "additionalProperties": false, "required": ["source", "source_snapshot", "question_rank", "question_id", "requirement_id", "fact_ids", "draft_only", "external_actions_authorized"], "properties": {"source": {"const": "private_recruiter_reply_triage"}, "source_snapshot": {"type": "string", "pattern": "^snap-triage-sha256-[0-9a-f]{64}$"}, "question_rank": {"const": 1}, "question_id": {"const": "Q-001"}, "requirement_id": {"const": "R-001"}, "fact_ids": {"$ref": "#/$defs/fact_ids"}, "draft_only": {"const": true}, "external_actions_authorized": {"const": false}}},
    "fact_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"const": "F-001"}},
    "delivery": {"type": "object", "additionalProperties": false, "required": ["draft_only", "external_actions_authorized", "manual_reentry_required", "auto_start", "local_save_mode", "raw_reply_retained"], "properties": {"draft_only": {"const": true}, "external_actions_authorized": {"const": false}, "manual_reentry_required": {"const": true}, "auto_start": {"const": false}, "local_save_mode": {"const": "disabled"}, "raw_reply_retained": {"const": false}}}
  }
}

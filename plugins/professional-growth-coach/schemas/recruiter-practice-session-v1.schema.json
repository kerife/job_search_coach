{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/professional-growth-coach/recruiter-practice-session-v1.schema.json",
  "title": "Private Recruiter Practice Session v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_kind", "locale", "state", "safe_context", "requirement", "question", "facts", "observed_answer", "rubric", "feedback", "delivery"],
  "properties": {
    "schema_version": {"const": "recruiter-practice-session-v1"},
    "session_kind": {"const": "private_recruiter_practice"},
    "locale": {"enum": ["es", "en"]},
    "state": {"enum": ["ready_to_practice", "awaiting_answer", "feedback_available"]},
    "safe_context": {"$ref": "#/$defs/safe_context"},
    "requirement": {"$ref": "#/$defs/requirement"},
    "question": {"$ref": "#/$defs/question"},
    "facts": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/fact"}},
    "observed_answer": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/observed_answer"}]},
    "rubric": {"$ref": "#/$defs/rubric"},
    "feedback": {"$ref": "#/$defs/feedback"},
    "delivery": {"$ref": "#/$defs/delivery"},
    "handoff_context": {"$ref": "#/$defs/handoff_context"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"enum": ["ready_to_practice", "awaiting_answer"]}}, "required": ["state"]},
      "then": {"properties": {"observed_answer": {"const": null}, "feedback": {"$ref": "#/$defs/pre_answer_feedback"}}}
    },
    {
      "if": {"properties": {"state": {"const": "feedback_available"}}, "required": ["state"]},
      "then": {"properties": {"observed_answer": {"$ref": "#/$defs/observed_answer"}, "feedback": {"allOf": [{"$ref": "#/$defs/feedback"}, {"properties": {"score_state": {"const": "categorical"}, "observations": {"minItems": 1}}}]}}}
    }
    ,{
      "if": {"properties": {"handoff_context": {"properties": {"source": {"const": "executive_career_dossier"}}}}, "required": ["handoff_context"]},
      "then": {"properties": {"handoff_context": {"required": ["claim_ids", "evidence_ids"]}}}
    },
    {
      "if": {"properties": {"handoff_context": {"properties": {"source": {"const": "executive_career_dossier"}}}}, "required": ["handoff_context"]},
      "then": {"properties": {"handoff_context": {"properties": {"source_snapshot": {"pattern": "^snap-dossier-[0-9]{3}$"}}}}}
    },
    {
      "if": {"properties": {"handoff_context": {"properties": {"source": {"const": "private_recruiter_reply_triage"}}}}, "required": ["handoff_context"]},
      "then": {"properties": {"handoff_context": {"properties": {"source_snapshot": {"pattern": "^snap-triage-[0-9]{3}$"}}}}}
    }
  ],
  "$defs": {
    "prose_control_guard": {"type": "string", "allOf": [{"not": {"pattern": ".*[\u0000-\u001f\u007f-\u009f\u00ad\u0600-\u0605\u061c\u06dd\u070f\u0890-\u0891\u08e2\u180e\u200b-\u200f\u202a-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb\ud804\udcbd\ud804\udccd\ud80d\udc30\ud80d\udc31\ud80d\udc32\ud80d\udc33\ud80d\udc34\ud80d\udc35\ud80d\udc36\ud80d\udc37\ud80d\udc38\ud80d\udc39\ud80d\udc3a\ud80d\udc3b\ud80d\udc3c\ud80d\udc3d\ud80d\udc3e\ud80d\udc3f\ud82f\udca0\ud82f\udca1\ud82f\udca2\ud82f\udca3\ud834\udd73\ud834\udd74\ud834\udd75\ud834\udd76\ud834\udd77\ud834\udd78\ud834\udd79\ud834\udd7a\udb40\udc01\udb40\udc20\udb40\udc21\udb40\udc22\udb40\udc23\udb40\udc24\udb40\udc25\udb40\udc26\udb40\udc27\udb40\udc28\udb40\udc29\udb40\udc2a\udb40\udc2b\udb40\udc2c\udb40\udc2d\udb40\udc2e\udb40\udc2f\udb40\udc30\udb40\udc31\udb40\udc32\udb40\udc33\udb40\udc34\udb40\udc35\udb40\udc36\udb40\udc37\udb40\udc38\udb40\udc39\udb40\udc3a\udb40\udc3b\udb40\udc3c\udb40\udc3d\udb40\udc3e\udb40\udc3f\udb40\udc40\udb40\udc41\udb40\udc42\udb40\udc43\udb40\udc44\udb40\udc45\udb40\udc46\udb40\udc47\udb40\udc48\udb40\udc49\udb40\udc4a\udb40\udc4b\udb40\udc4c\udb40\udc4d\udb40\udc4e\udb40\udc4f\udb40\udc50\udb40\udc51\udb40\udc52\udb40\udc53\udb40\udc54\udb40\udc55\udb40\udc56\udb40\udc57\udb40\udc58\udb40\udc59\udb40\udc5a\udb40\udc5b\udb40\udc5c\udb40\udc5d\udb40\udc5e\udb40\udc5f\udb40\udc60\udb40\udc61\udb40\udc62\udb40\udc63\udb40\udc64\udb40\udc65\udb40\udc66\udb40\udc67\udb40\udc68\udb40\udc69\udb40\udc6a\udb40\udc6b\udb40\udc6c\udb40\udc6d\udb40\udc6e\udb40\udc6f\udb40\udc70\udb40\udc71\udb40\udc72\udb40\udc73\udb40\udc74\udb40\udc75\udb40\udc76\udb40\udc77\udb40\udc78\udb40\udc79\udb40\udc7a\udb40\udc7b\udb40\udc7c\udb40\udc7d\udb40\udc7e\udb40\udc7f].*"}}]},
    "safe_context": {"type": "object", "additionalProperties": false, "required": ["stage", "vacancy_state", "summary"], "properties": {"stage": {"const": "recruiter_screen"}, "vacancy_state": {"const": "safe_summary_provided"}, "summary": {"allOf": [{"$ref": "#/$defs/prose_control_guard"}, {"type": "string", "minLength": 1, "maxLength": 280}]}}},
    "requirement": {"type": "object", "additionalProperties": false, "required": ["id", "summary", "fact_ids"], "properties": {"id": {"pattern": "^R-[0-9]{3}$"}, "summary": {"allOf": [{"$ref": "#/$defs/prose_control_guard"}, {"type": "string", "minLength": 1, "maxLength": 280}]}, "fact_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"pattern": "^F-[0-9]{3}$"}}}},
    "question": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "text", "requirement_id", "fact_ids"], "properties": {"id": {"pattern": "^Q-[0-9]{3}$"}, "kind": {"enum": ["screen_opening", "proof_example", "eligibility_boundary", "compensation_boundary", "missing_detail"]}, "text": {"allOf": [{"$ref": "#/$defs/prose_control_guard"}, {"type": "string", "minLength": 1, "maxLength": 500}]}, "requirement_id": {"pattern": "^R-[0-9]{3}$"}, "fact_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"pattern": "^F-[0-9]{3}$"}}}},
    "fact": {"type": "object", "additionalProperties": false, "required": ["id", "state", "summary"], "properties": {"id": {"pattern": "^F-[0-9]{3}$"}, "state": {"enum": ["verified", "candidate_reported"]}, "summary": {"allOf": [{"$ref": "#/$defs/prose_control_guard"}, {"type": "string", "minLength": 1, "maxLength": 500}]}}},
    "observed_answer": {"type": "object", "additionalProperties": false, "required": ["id", "text", "storage"], "properties": {"id": {"const": "OBS-001"}, "text": {"allOf": [{"$ref": "#/$defs/prose_control_guard"}, {"type": "string", "minLength": 1, "maxLength": 2000}]}, "storage": {"const": "ephemeral"}}},
    "rubric": {"type": "object", "additionalProperties": false, "required": ["id", "criterion"], "properties": {"id": {"const": "RB-001"}, "criterion": {"allOf": [{"$ref": "#/$defs/prose_control_guard"}, {"type": "string", "minLength": 1, "maxLength": 500}]}}},
    "feedback": {"type": "object", "additionalProperties": false, "required": ["score", "score_state", "observations"], "properties": {"score": {"const": "unknown"}, "score_state": {"enum": ["unknown", "categorical"]}, "observations": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/observation"}}}},
    "pre_answer_feedback": {"type": "object", "additionalProperties": false, "required": ["score", "score_state", "observations"], "properties": {"score": {"const": "unknown"}, "score_state": {"const": "unknown"}, "observations": {"type": "array", "maxItems": 0}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["label", "statement", "source_refs"], "properties": {"label": {"enum": ["solid", "confirm", "do_not_assert"]}, "statement": {"allOf": [{"$ref": "#/$defs/prose_control_guard"}, {"type": "string", "minLength": 1, "maxLength": 500}]}, "source_refs": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["OBS-001", "RB-001"]}}}},
    "delivery": {"type": "object", "additionalProperties": false, "required": ["draft_only", "external_actions_authorized", "local_save_mode", "raw_answer_retained"], "properties": {"draft_only": {"const": true}, "external_actions_authorized": {"const": false}, "local_save_mode": {"const": "disabled"}, "raw_answer_retained": {"const": false}}},
    "handoff_context": {"type": "object", "additionalProperties": false, "required": ["source", "source_snapshot", "question_rank", "question_id", "requirement_id", "fact_ids", "draft_only", "external_actions_authorized"], "properties": {"source": {"enum": ["executive_career_dossier", "private_recruiter_reply_triage"]}, "source_snapshot": {"pattern": "^snap-(?:dossier|triage)-[0-9]{3}$"}, "question_rank": {"const": 1}, "question_id": {"pattern": "^Q-[0-9]{3}$"}, "requirement_id": {"pattern": "^R-[0-9]{3}$"}, "fact_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"pattern": "^F-[0-9]{3}$"}}, "claim_ids": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"pattern": "^C-[0-9]{3}$"}}, "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"pattern": "^E-[0-9]{3}$"}}, "draft_only": {"const": true}, "external_actions_authorized": {"const": false}}}
  }
}

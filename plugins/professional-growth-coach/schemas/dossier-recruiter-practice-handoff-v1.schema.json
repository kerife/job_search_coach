{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/professional-growth-coach/dossier-recruiter-practice-handoff-v1.schema.json",
  "title": "Dossier Recruiter Practice Handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "source_snapshot", "dossier_projection", "practice_projection", "delivery"],
  "properties": {
    "schema_version": {"const": "dossier-recruiter-practice-handoff-v1"},
    "source": {"const": "executive_career_dossier"},
    "source_snapshot": {"type": "string", "pattern": "^snap-dossier-sha256-[0-9a-f]{64}$"},
    "dossier_projection": {"$ref": "#/$defs/dossier_projection"},
    "practice_projection": {"$ref": "#/$defs/practice_projection"},
    "delivery": {"$ref": "#/$defs/delivery"}
  },
  "$defs": {
    "dossier_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_rank", "claim_ids", "evidence_ids", "question_evidence_ids", "source_fact_evidence_id", "fact_state", "fact_summary"],
      "properties": {
        "question_rank": {"const": 1},
        "claim_ids": {"$ref": "#/$defs/claim_ids"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "question_evidence_ids": {"$ref": "#/$defs/evidence_ids"},
        "source_fact_evidence_id": {"pattern": "^E-[0-9]{3}$"},
        "fact_state": {"enum": ["verified", "candidate_reported"]},
        "fact_summary": {"$ref": "#/$defs/safe_text_500"}
      }
    },
    "practice_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["safe_context", "requirement", "question", "facts", "handoff_context"],
      "properties": {
        "safe_context": {"$ref": "#/$defs/safe_context"},
        "requirement": {"$ref": "#/$defs/requirement"},
        "question": {"$ref": "#/$defs/question"},
        "facts": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/fact"}},
        "handoff_context": {"$ref": "#/$defs/handoff_context"}
      }
    },
    "safe_context": {"type": "object", "additionalProperties": false, "required": ["stage", "vacancy_state", "summary"], "properties": {"stage": {"const": "recruiter_screen"}, "vacancy_state": {"const": "safe_summary_provided"}, "summary": {"$ref": "#/$defs/safe_text_280"}}},
    "requirement": {"type": "object", "additionalProperties": false, "required": ["id", "summary", "fact_ids"], "properties": {"id": {"const": "R-001"}, "summary": {"$ref": "#/$defs/safe_text_280"}, "fact_ids": {"$ref": "#/$defs/fact_ids"}}},
    "question": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "text", "requirement_id", "fact_ids"], "properties": {"id": {"const": "Q-001"}, "kind": {"const": "screen_opening"}, "text": {"$ref": "#/$defs/safe_text_500"}, "requirement_id": {"const": "R-001"}, "fact_ids": {"$ref": "#/$defs/fact_ids"}}},
    "fact": {"type": "object", "additionalProperties": false, "required": ["id", "state", "summary"], "properties": {"id": {"const": "F-001"}, "state": {"enum": ["verified", "candidate_reported"]}, "summary": {"$ref": "#/$defs/safe_text_500"}}},
    "handoff_context": {"type": "object", "additionalProperties": false, "required": ["source", "source_snapshot", "question_rank", "question_id", "requirement_id", "fact_ids", "claim_ids", "evidence_ids", "draft_only", "external_actions_authorized"], "properties": {"source": {"const": "executive_career_dossier"}, "source_snapshot": {"type": "string", "pattern": "^snap-dossier-sha256-[0-9a-f]{64}$"}, "question_rank": {"const": 1}, "question_id": {"const": "Q-001"}, "requirement_id": {"const": "R-001"}, "fact_ids": {"$ref": "#/$defs/fact_ids"}, "claim_ids": {"$ref": "#/$defs/claim_ids"}, "evidence_ids": {"$ref": "#/$defs/evidence_ids"}, "draft_only": {"const": true}, "external_actions_authorized": {"const": false}}},
    "claim_ids": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"pattern": "^C-[0-9]{3}$"}},
    "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": {"pattern": "^E-[0-9]{3}$"}},
    "fact_ids": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"const": "F-001"}},
    "safe_text_guard": {"type": "string", "minLength": 1, "allOf": [{"not": {"pattern": ".*[\\u0000-\\u001f\\u007f-\\u009f\\u200b-\\u200d\\u2060\\ufeff].*"}}, {"not": {"pattern": "(?i).*(?<![A-Z0-9+.-])(?:[A-Z][A-Z0-9+.-]*):(?=//|[^\\s]).*"}}, {"not": {"pattern": "(?i).*\\bwww\\..*"}}, {"not": {"pattern": "(?i).*(?<![A-Z0-9_])(?:~[/\\\\]|\\.\\.?[/\\\\]|/(?:users|home|private|tmp|var|etc|opt|volumes|workspace)[/\\\\]|[A-Z]:[/\\\\]|\\\\\\\\[^\\s\\\\]+\\\\[^\\s\\\\]+).*"}}, {"not": {"pattern": "(?i).*\\b(?:candidate\\s+name|nombre\\s+del\\s+candidat[oa]|name|contact|contacto|tel[eé]fono(?:\\s+de\\s+contacto)?|phone|email|correo|recruiter\\s+name|nombre\\s+del\\s+reclutador)\\s*[:=].*"}}, {"not": {"pattern": ".*\\b(?i:(?:candidate|candidat[oa]|recruiter|reclutador[ae]?)\\s+(?:name\\s+|nombre\\s+)?)[A-ZÁÉÍÓÚÑ][A-ZÁÉÍÓÚÑa-záéíóúñ'-]+\\s+[A-ZÁÉÍÓÚÑ][A-ZÁÉÍÓÚÑa-záéíóúñ'-]+\\b.*"}}, {"not": {"pattern": ".*\\b(?i:(?:mr|mrs|ms|dr|sr|sra|srta)\\.?)\\s+[A-ZÁÉÍÓÚÑ][A-ZÁÉÍÓÚÑa-záéíóúñ'-]+\\s+[A-ZÁÉÍÓÚÑ][A-ZÁÉÍÓÚÑa-záéíóúñ'-]+\\b.*"}}, {"not": {"pattern": "(?i).*\\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}\\b.*"}}, {"not": {"pattern": ".*(?<!\\d)(?:\\+\\d{1,3}[\\s.-])?(?:\\(?\\d{2,4}\\)?[\\s.-])\\d{3,4}[\\s.-]\\d{3,4}(?!\\d).*"}}, {"not": {"pattern": "(?i).*\\b(?:raw\\s+(?:profile|vacancy|job\\s+description|reply|source|cv|resume)|texto\\s+crudo\\s+del\\s+(?:perfil|puesto|mensaje|origen)|perfil\\s+de\\s+linkedin|linkedin\\s+profile|curriculum\\s+vitae|resume)\\b.*"}}, {"not": {"pattern": "(?i).*\\b(?:browser(?:[_-]session)?|session|sesi[oó]n)[_-]?(?:id|identifier|token)\\s*[:=].*"}}, {"not": {"pattern": "(?i).*\\b(?:browser|session|sesi[oó]n)[_-][A-Z0-9_-]{3,}\\b.*"}}, {"not": {"pattern": "(?i).*\\b(?:sha(?:1|256|512)|md5|hash)\\s*[:=].*"}}, {"not": {"pattern": "(?i).*\\b[A-F0-9]{32,128}\\b.*"}}]},
    "safe_path_guard": {"not": {"pattern": "(?i).*(?<![A-Z0-9_])(?:~[/\\\\]|\\.\\.?[/\\\\]|/(?:users|home|private|tmp|var|etc|opt|volumes|workspace|root|usr|bin|sbin|lib|lib64|system|library|applications|mnt|srv)(?:[/\\\\]|$)|//[^\\s/]+(?:[/\\\\]|$)|[A-Z]:[/\\\\]|\\\\\\\\[^\\s\\\\]+\\\\[^\\s\\\\]+).*"}},
    "prose_control_guard": {"type": "string", "allOf": [{"not": {"pattern": ".*[\u0000-\u001f\u007f-\u009f\u00ad\u0600-\u0605\u061c\u06dd\u070f\u0890-\u0891\u08e2\u180e\u200b-\u200f\u202a-\u202e\u2060-\u2064\u2066-\u206f\ufeff\ufff9-\ufffb\ud804\udcbd\ud804\udccd\ud80d\udc30\ud80d\udc31\ud80d\udc32\ud80d\udc33\ud80d\udc34\ud80d\udc35\ud80d\udc36\ud80d\udc37\ud80d\udc38\ud80d\udc39\ud80d\udc3a\ud80d\udc3b\ud80d\udc3c\ud80d\udc3d\ud80d\udc3e\ud80d\udc3f\ud82f\udca0\ud82f\udca1\ud82f\udca2\ud82f\udca3\ud834\udd73\ud834\udd74\ud834\udd75\ud834\udd76\ud834\udd77\ud834\udd78\ud834\udd79\ud834\udd7a\udb40\udc01\udb40\udc20\udb40\udc21\udb40\udc22\udb40\udc23\udb40\udc24\udb40\udc25\udb40\udc26\udb40\udc27\udb40\udc28\udb40\udc29\udb40\udc2a\udb40\udc2b\udb40\udc2c\udb40\udc2d\udb40\udc2e\udb40\udc2f\udb40\udc30\udb40\udc31\udb40\udc32\udb40\udc33\udb40\udc34\udb40\udc35\udb40\udc36\udb40\udc37\udb40\udc38\udb40\udc39\udb40\udc3a\udb40\udc3b\udb40\udc3c\udb40\udc3d\udb40\udc3e\udb40\udc3f\udb40\udc40\udb40\udc41\udb40\udc42\udb40\udc43\udb40\udc44\udb40\udc45\udb40\udc46\udb40\udc47\udb40\udc48\udb40\udc49\udb40\udc4a\udb40\udc4b\udb40\udc4c\udb40\udc4d\udb40\udc4e\udb40\udc4f\udb40\udc50\udb40\udc51\udb40\udc52\udb40\udc53\udb40\udc54\udb40\udc55\udb40\udc56\udb40\udc57\udb40\udc58\udb40\udc59\udb40\udc5a\udb40\udc5b\udb40\udc5c\udb40\udc5d\udb40\udc5e\udb40\udc5f\udb40\udc60\udb40\udc61\udb40\udc62\udb40\udc63\udb40\udc64\udb40\udc65\udb40\udc66\udb40\udc67\udb40\udc68\udb40\udc69\udb40\udc6a\udb40\udc6b\udb40\udc6c\udb40\udc6d\udb40\udc6e\udb40\udc6f\udb40\udc70\udb40\udc71\udb40\udc72\udb40\udc73\udb40\udc74\udb40\udc75\udb40\udc76\udb40\udc77\udb40\udc78\udb40\udc79\udb40\udc7a\udb40\udc7b\udb40\udc7c\udb40\udc7d\udb40\udc7e\udb40\udc7f].*"}}]},
    "safe_text_280": {"allOf": [{"$ref": "#/$defs/safe_text_guard"}, {"$ref": "#/$defs/safe_path_guard"}, {"$ref": "#/$defs/prose_control_guard"}, {"type": "string", "maxLength": 280}]},
    "safe_text_500": {"allOf": [{"$ref": "#/$defs/safe_text_guard"}, {"$ref": "#/$defs/safe_path_guard"}, {"$ref": "#/$defs/prose_control_guard"}, {"type": "string", "maxLength": 500}]},
    "delivery": {"type": "object", "additionalProperties": false, "required": ["draft_only", "external_actions_authorized", "manual_reentry_required", "auto_start", "candidate_answer_state", "score_state", "local_save_mode", "raw_answer_retained"], "properties": {"draft_only": {"const": true}, "external_actions_authorized": {"const": false}, "manual_reentry_required": {"const": true}, "auto_start": {"const": false}, "candidate_answer_state": {"const": "unanswered"}, "score_state": {"const": "unknown"}, "local_save_mode": {"const": "disabled"}, "raw_answer_retained": {"const": false}}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/professional-growth-coach/private-recruiter-screen-debrief-v1.schema.json",
  "title": "Private Recruiter Screen Debrief v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "locale", "observed_date", "source_receipt", "source_checkpoint", "source_intake", "source_snapshot", "coverage", "unknown_topics", "facts_used", "decision", "measurement_event", "replay_fingerprint", "handoff", "delivery"],
  "properties": {
    "schema_version": {"const": "private-recruiter-screen-debrief-v1"},
    "artifact_kind": {"const": "private_recruiter_screen_debrief"},
    "locale": {"enum": ["en", "es"]},
    "observed_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source_receipt": {"type": "object", "minProperties": 1},
    "source_checkpoint": {"type": "object", "minProperties": 1},
    "source_intake": {"type": "object", "minProperties": 1},
    "source_snapshot": {"type": "string", "pattern": "^snap-shortlist-sha256-[0-9a-f]{64}$"},
    "coverage": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["topic", "status", "note"], "properties": {"topic": {"enum": ["requirement", "scope", "team_context"]}, "status": {"enum": ["discussed", "not_discussed", "unclear"]}, "note": {"type": "string", "minLength": 1, "maxLength": 240}}}},
    "unknown_topics": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1, "maxLength": 180}},
    "facts_used": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^F-[0-9]{3}$"}},
    "decision": {"enum": ["continue_review", "pause", "stop"]},
    "measurement_event": {"enum": ["next_stage_review", "debrief_context", "stop_decision"]},
    "replay_fingerprint": {"type": "string", "pattern": "^replay-debrief-sha256-[0-9a-f]{64}$"},
    "handoff": {"type": "object", "additionalProperties": false, "required": ["next_safe_action", "manual_review_required", "draft_only", "external_actions_authorized", "no_message_action", "no_calendar_action"], "properties": {"next_safe_action": {"enum": ["manual_prepare_next_stage_review", "collect_debrief_context", "record_stop_decision"]}, "manual_review_required": {"const": true}, "draft_only": {"const": true}, "external_actions_authorized": {"const": false}, "no_message_action": {"const": true}, "no_calendar_action": {"const": true}}},
    "delivery": {"type": "object", "additionalProperties": false, "required": ["draft_only", "external_actions_authorized", "no_message_action", "no_calendar_action", "raw_transcript_retained", "local_save_mode"], "properties": {"draft_only": {"const": true}, "external_actions_authorized": {"const": false}, "no_message_action": {"const": true}, "no_calendar_action": {"const": true}, "raw_transcript_retained": {"const": false}, "local_save_mode": {"const": "disabled"}}}
  }
}

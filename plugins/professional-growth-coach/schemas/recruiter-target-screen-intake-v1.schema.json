    "source_gate": {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_kind", "locale", "as_of_date", "source_shortlist", "source_snapshot", "decision_counts", "decision_rows", "screen_context", "handoff", "delivery"], "properties": {
      "schema_version": {"const": "recruiter-target-decision-gate-v1"}, "artifact_kind": {"const": "private_recruiter_target_decision_gate"}, "locale": {"enum": ["es", "en"]}, "as_of_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "source_shortlist": {"$ref": "#/$defs/source_shortlist"}, "source_snapshot": {"type": "string", "pattern": "^snap-shortlist-sha256-[0-9a-f]{64}$"}, "decision_counts": {"$ref": "#/$defs/source_decision_counts"}, "decision_rows": {"type": "array", "minItems": 3, "maxItems": 6, "items": {"$ref": "#/$defs/source_decision_row"}}, "screen_context": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/source_screen_context"}]}, "handoff": {"$ref": "#/$defs/source_gate_handoff"}, "delivery": {"$ref": "#/$defs/source_gate_delivery"}

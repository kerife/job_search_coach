    {"if": {"properties": {"readiness_decision": {"const": "stop"}}, "required": ["readiness_decision"]}, "then": {"properties": {"measurement_event": {"const": "stop_decision"}, "handoff": {"properties": {"next_safe_action": {"const": "stop_and_record"}}}}}},
    {"if": {"properties": {"measurement_event": {"const": "screen_context_submitted"}}, "required": ["measurement_event"]}, "then": {"properties": {"readiness_decision": {"const": "ready"}, "handoff": {"properties": {"next_safe_action": {"const": "manual_prepare_role_interviews_review"}}}}}},

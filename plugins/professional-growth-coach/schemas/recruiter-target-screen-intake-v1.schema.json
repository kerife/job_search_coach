{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/professional-growth-coach/recruiter-target-screen-intake-v1.schema.json",
  "title": "Private recruiter target screen intake v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "locale", "as_of_date", "source_gate_snapshot", "source_gate", "target_id", "target_decision", "intake", "checks", "readiness_decision", "measurement_event", "handoff", "delivery"],
  "properties": {
    "schema_version": {"const": "recruiter-target-screen-intake-v1"},
    "artifact_kind": {"const": "private_recruiter_target_screen_intake"},
    "locale": {"enum": ["es", "en"]},
    "as_of_date": {"type": "string", "format": "date"},
    "source_gate_snapshot": {"type": "string", "pattern": "^snap-shortlist-sha256-[0-9a-f]{64}$"},
    "source_gate": {"type": "object", "required": ["schema_version", "artifact_kind", "locale", "as_of_date", "source_shortlist", "source_snapshot", "decision_counts", "decision_rows", "screen_context", "handoff", "delivery"], "additionalProperties": true},
    "target_id": {"type": "string", "pattern": "^T-[0-9]{3}$"},
    "target_decision": {"enum": ["advance", "clarify", "pause", "stop"]},
    "intake": {"type": "object", "additionalProperties": false, "required": ["stated_stage", "vacancy_requirements", "candidate_fact_ids", "company_evidence_state", "source_date"], "properties": {
      "stated_stage": {"enum": ["recruiter_screen", "first_interview", "technical_screen"]},
      "vacancy_requirements": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "pattern": "^V-[0-9]{3}:\\s+.+$", "maxLength": 240}},
      "candidate_fact_ids": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "pattern": "^F-[0-9]{3}$"}},
      "company_evidence_state": {"enum": ["verified", "candidate_reported", "unknown"]},
      "source_date": {"type": "string", "format": "date"}
    }},
    "checks": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["check", "status", "evidence_note"], "properties": {
      "check": {"enum": ["target_context", "proof_packet", "low_friction_ask", "screen_readiness"]},
      "status": {"enum": ["pass", "clarify", "stop"]},
      "evidence_note": {"type": "string", "minLength": 1, "maxLength": 240}
    }}},
    "readiness_decision": {"enum": ["ready", "clarify_first", "stop"]},
    "measurement_event": {"enum": ["screen_context_submitted", "clarify_context", "stop_decision"]},
    "handoff": {"type": "object", "additionalProperties": false, "required": ["next_safe_action", "selected_module", "manual_review_required", "draft_only", "external_actions_authorized", "no_message_action", "no_calendar_action"], "properties": {
      "next_safe_action": {"enum": ["manual_prepare_role_interviews_review", "collect_screen_intake", "stop_and_record"]},
      "selected_module": {"const": "prepare-role-interviews"},
      "manual_review_required": {"const": true}, "draft_only": {"const": true}, "external_actions_authorized": {"const": false}, "no_message_action": {"const": true}, "no_calendar_action": {"const": true}
    }},
    "delivery": {"type": "object", "additionalProperties": false, "required": ["draft_only", "external_actions_authorized", "local_save_mode", "raw_contact_details_retained"], "properties": {
      "draft_only": {"const": true}, "external_actions_authorized": {"const": false}, "local_save_mode": {"const": "disabled"}, "raw_contact_details_retained": {"const": false}
    }}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/professional-growth-coach/executive-career-dossier-v1.schema.json",
  "title": "Executive Career Dossier v1",
  "type": "object",
  "required": ["schema_version", "dossier_kind", "locale", "evidence_as_of", "case_scope", "benchmarking", "requested_technology_terms", "focus", "evidence_scope", "evidence", "claims", "verdict", "coverage", "priorities", "recruiter_scan", "dimensions", "visual_review", "copy_blocks", "do_not_change", "screen_bridge", "questions", "seven_day_plan", "analytics", "market_context", "methodology_source_categories", "privacy", "authorization"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "executive-career-dossier-v1"},
    "dossier_kind": {"const": "linkedin_profile_diagnostic"},
    "locale": {"enum": ["es", "en"]},
    "evidence_as_of": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "case_scope": {"const": "single_candidate"},
    "benchmarking": {"const": "disabled"},
    "requested_technology_terms": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/requested_technology"}},
    "focus": {"$ref": "#/$defs/focus"},
    "evidence_scope": {"$ref": "#/$defs/evidence_scope"},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
    "verdict": {"$ref": "#/$defs/verdict"},
    "coverage": {"$ref": "#/$defs/coverage"},
    "priorities": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/priority"}},
    "recruiter_scan": {"$ref": "#/$defs/recruiter_scan"},
    "dimensions": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/dimension"}},
    "visual_review": {"$ref": "#/$defs/visual_review"},
    "copy_blocks": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/copy_block"}},
    "do_not_change": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/hold"}},
    "screen_bridge": {"$ref": "#/$defs/screen_bridge"},
    "questions": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/question"}},
    "seven_day_plan": {"type": "array", "minItems": 1, "maxItems": 7, "items": {"$ref": "#/$defs/plan"}},
    "analytics": {"$ref": "#/$defs/analytics"},
    "market_context": {"$ref": "#/$defs/market_context"},
    "methodology_source_categories": {"type": "array", "items": {"type": "string", "enum": ["ai_hiring_agents", "cover_image", "featured_section", "good_profile", "job_match", "job_seeker_hirer_connection", "profile_photo", "skills"]}, "uniqueItems": true},
    "privacy": {"$ref": "#/$defs/privacy"},
    "authorization": {"$ref": "#/$defs/authorization"}
  },
  "$defs": {
    "requested_technology": {"type": "object", "required": ["term", "claim_ids"], "additionalProperties": false, "properties": {"term": {"type": "string", "minLength": 1, "maxLength": 80}, "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^C-[0-9]{3}$"}, "uniqueItems": true}}},
    "focus": {"type": "object", "required": ["statement", "state", "claim_ids"], "additionalProperties": false, "properties": {"statement": {"type": "string", "minLength": 1, "maxLength": 500}, "state": {"const": "target_under_review"}, "claim_ids": {"type": "array", "items": {"type": "string", "pattern": "^C-[0-9]{3}$"}, "uniqueItems": true}}},
    "evidence_scope": {"type": "object", "required": ["inspection_mode", "captured_as_of", "inspected_sections", "unavailable_sections", "confidence", "visual_state", "visual_capture_ref"], "additionalProperties": false, "properties": {"inspection_mode": {"enum": ["live_read_only", "provided_material", "mixed"]}, "captured_as_of": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "inspected_sections": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}, "unavailable_sections": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "confidence": {"enum": ["low", "medium", "high"]}, "visual_state": {"enum": ["unavailable", "structural_only", "partial_visual", "authorized_visual_visible"]}, "visual_capture_ref": {"type": ["string", "null"], "pattern": "^CAP-[0-9]{3}$"}}},
    "evidence": {"type": "object", "required": ["id", "state", "section", "source_kind", "paraphrase", "capture_ref"], "additionalProperties": false, "properties": {"id": {"type": "string", "pattern": "^E-[0-9]{3}$"}, "state": {"enum": ["verified", "candidate_reported", "inferred", "unknown"]}, "section": {"enum": ["headline", "about", "experience", "skills", "proof", "completeness", "photo", "banner", "visual", "analytics", "market"]}, "source_kind": {"enum": ["provided_material", "candidate_statement", "authorized_visible", "consented_aggregate", "dated_vacancy_research"]}, "paraphrase": {"type": "string", "minLength": 1, "maxLength": 500}, "capture_ref": {"type": ["string", "null"], "pattern": "^CAP-[0-9]{3}$"}}},
    "claim": {"type": "object", "required": ["id", "state", "paraphrase", "evidence_ids", "public_use"], "additionalProperties": false, "properties": {"id": {"type": "string", "pattern": "^C-[0-9]{3}$"}, "state": {"enum": ["verified", "candidate_reported", "inferred", "unknown"]}, "paraphrase": {"type": "string", "minLength": 1, "maxLength": 500}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E-[0-9]{3}$"}, "uniqueItems": true}, "public_use": {"enum": ["allowed", "confirmation_required", "blocked"]}}},
    "verdict": {"type": "object", "required": ["statement", "rationale", "start_here_action", "evidence_state", "evidence_ids"], "additionalProperties": false, "properties": {"statement": {"type": "string", "minLength": 1, "maxLength": 500}, "rationale": {"type": "string", "minLength": 1, "maxLength": 500}, "start_here_action": {"type": "string", "minLength": 1, "maxLength": 500}, "evidence_state": {"enum": ["verified", "candidate_reported", "inferred", "unknown"]}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E-[0-9]{3}$"}, "uniqueItems": true}}},
    "coverage": {"type": "object", "required": ["evaluated_count", "scored_weight", "not_scored_weight", "overall_score", "confidence"], "additionalProperties": false, "properties": {"evaluated_count": {"type": "integer", "minimum": 0, "maximum": 7}, "scored_weight": {"type": "integer", "minimum": 0, "maximum": 100}, "not_scored_weight": {"type": "integer", "minimum": 0, "maximum": 100}, "overall_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100}, "confidence": {"enum": ["low", "medium", "high"]}}},
    "priority": {"type": "object", "required": ["rank", "title", "problem", "why_now", "action", "timebox_minutes", "done_when", "evidence_state", "evidence_ids", "dimensions"], "additionalProperties": false, "properties": {"rank": {"type": "integer", "minimum": 1, "maximum": 3}, "title": {"type": "string", "minLength": 1, "maxLength": 500}, "problem": {"type": "string", "minLength": 1, "maxLength": 500}, "why_now": {"type": "string", "minLength": 1, "maxLength": 500}, "action": {"type": "string", "minLength": 1, "maxLength": 500}, "timebox_minutes": {"type": "integer", "minimum": 5, "maximum": 120}, "done_when": {"type": "string", "minLength": 1, "maxLength": 500}, "evidence_state": {"enum": ["verified", "candidate_reported", "inferred", "unknown"]}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E-[0-9]{3}$"}, "uniqueItems": true}, "dimensions": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}}},
    "recruiter_scan": {"type": "object", "required": ["understood_signal", "ambiguity", "positioning_bridge"], "additionalProperties": false, "properties": {"understood_signal": {"$ref": "#/$defs/recruiter_guidance"}, "ambiguity": {"$ref": "#/$defs/recruiter_guidance"}, "positioning_bridge": {"$ref": "#/$defs/recruiter_guidance"}}},
    "recruiter_guidance": {"type": "object", "required": ["statement", "evidence_state", "evidence_ids"], "additionalProperties": false, "properties": {"statement": {"type": "string", "minLength": 1, "maxLength": 500}, "evidence_state": {"enum": ["verified", "candidate_reported", "inferred", "unknown"]}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E-[0-9]{3}$"}, "uniqueItems": true}}},
    "dimension": {"type": "object", "required": ["dimension", "state", "score", "reason", "evidence_state", "evidence_ids", "capture_ref"], "additionalProperties": false, "properties": {"dimension": {"enum": ["visual", "headline", "about", "experience", "skills", "proof", "completeness"]}, "state": {"enum": ["evaluated", "not_evaluated"]}, "score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100}, "reason": {"type": "string", "minLength": 1, "maxLength": 500}, "evidence_state": {"enum": ["verified", "candidate_reported", "inferred", "unknown"]}, "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^E-[0-9]{3}$"}, "uniqueItems": true}, "capture_ref": {"type": ["string", "null"], "pattern": "^CAP-[0-9]{3}$"}}},
    "visual_review": {"type": "object", "required": ["photo", "banner"], "additionalProperties": false, "properties": {"photo": {"$ref": "#/$defs/visual_item"}, "banner": {"$ref": "#/$defs/visual_item"}}},
    "visual_item": {"type": "object", "required": ["state", "finding", "private_action", "evidence_state", "evidence_ids", "capture_ref", "score"], "additionalProperties": false, "properties": {"state": {"enum": ["evaluated", "not_evaluated"]}, "finding": {"type": "string", "minLength": 1, "maxLength": 500}, "private_action": {"type": ["string", "null"], "maxLength": 500}, "evidence_state": {"enum": ["verified", "candidate_reported", "inferred", "unknown"]}, "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^E-[0-9]{3}$"}, "uniqueItems": true}, "capture_ref": {"type": ["string", "null"], "pattern": "^CAP-[0-9]{3}$"}, "score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100}}},
    "copy_block": {"type": "object", "required": ["category", "state", "copy", "why_it_works", "claim_ids", "evidence_ids", "claim_boundary", "evidence_state", "question_rank"], "additionalProperties": false, "properties": {"category": {"enum": ["headline", "about_opening", "experience_bullet"]}, "state": {"enum": ["ready", "requires_confirmation", "omit"]}, "copy": {"type": ["string", "null"], "maxLength": 500}, "why_it_works": {"type": "string", "minLength": 1, "maxLength": 500}, "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^C-[0-9]{3}$"}, "uniqueItems": true}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E-[0-9]{3}$"}, "uniqueItems": true}, "claim_boundary": {"type": "string", "minLength": 1, "maxLength": 500}, "evidence_state": {"enum": ["verified", "candidate_reported", "inferred", "unknown"]}, "question_rank": {"type": ["integer", "null"], "minimum": 1, "maximum": 3}}},
    "screen_bridge": {"type": "object", "required": ["state", "copy", "why_it_works", "claim_ids", "evidence_ids", "claim_boundary", "evidence_state", "question_rank"], "additionalProperties": false, "properties": {"state": {"enum": ["ready", "requires_confirmation", "omit"]}, "copy": {"type": ["string", "null"], "maxLength": 500}, "why_it_works": {"type": "string", "minLength": 1, "maxLength": 500}, "claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^C-[0-9]{3}$"}, "uniqueItems": true}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E-[0-9]{3}$"}, "uniqueItems": true}, "claim_boundary": {"type": "string", "minLength": 1, "maxLength": 500}, "evidence_state": {"enum": ["verified", "candidate_reported", "inferred", "unknown"]}, "question_rank": {"type": ["integer", "null"], "minimum": 1, "maximum": 3}}},
    "hold": {"type": "object", "required": ["claim_ids", "evidence_ids", "reason", "evidence_state"], "additionalProperties": false, "properties": {"claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^C-[0-9]{3}$"}, "uniqueItems": true}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E-[0-9]{3}$"}, "uniqueItems": true}, "reason": {"type": "string", "minLength": 1, "maxLength": 500}, "evidence_state": {"enum": ["verified", "candidate_reported", "inferred", "unknown"]}}},
    "question": {"type": "object", "required": ["rank", "question", "changes", "linked_copy_category", "evidence_ids"], "additionalProperties": false, "properties": {"rank": {"type": "integer", "minimum": 1, "maximum": 3}, "question": {"type": "string", "minLength": 1, "maxLength": 500}, "changes": {"type": "string", "minLength": 1, "maxLength": 500}, "linked_copy_category": {"enum": ["headline", "about_opening", "experience_bullet", "screen_bridge"]}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E-[0-9]{3}$"}, "uniqueItems": true}}},
    "plan": {"type": "object", "required": ["day", "category", "action", "done_when", "evidence_ids"], "additionalProperties": false, "properties": {"day": {"type": "integer", "minimum": 1, "maximum": 7}, "category": {"enum": ["confirm_target", "validate_fact", "review_copy", "prepare_proof"]}, "action": {"type": "string", "minLength": 1, "maxLength": 500}, "done_when": {"type": "string", "minLength": 1, "maxLength": 500}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E-[0-9]{3}$"}, "uniqueItems": true}}},
    "analytics": {"oneOf": [{"type": "object", "required": ["state", "reason"], "additionalProperties": false, "properties": {"state": {"enum": ["not_requested", "unavailable"]}, "reason": {"type": "string", "minLength": 1, "maxLength": 500}}}, {"type": "object", "required": ["state", "explicit_report_consent", "observed_as_of", "window_days", "raw_records_retained", "profile_views", "inbound_contacts", "qualified_contacts", "qualified_contact_rate", "evidence_ids", "causality_boundary"], "additionalProperties": false, "properties": {"state": {"const": "observed_aggregate"}, "explicit_report_consent": {"const": true}, "observed_as_of": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "window_days": {"type": "integer", "minimum": 1}, "raw_records_retained": {"const": false}, "profile_views": {"type": "integer", "minimum": 0}, "inbound_contacts": {"type": "integer", "minimum": 0}, "qualified_contacts": {"type": "integer", "minimum": 0}, "qualified_contact_rate": {"type": "number", "minimum": 0, "maximum": 100}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E-[0-9]{3}$"}, "uniqueItems": true}, "causality_boundary": {"const": "observed_not_attributed"}}}]},
    "market_context": {"oneOf": [{"type": "object", "required": ["state", "reason"], "additionalProperties": false, "properties": {"state": {"const": "not_researched"}, "reason": {"type": "string", "minLength": 1, "maxLength": 500}}}, {"type": "object", "required": ["state", "geography", "arrangement", "research_date", "vacancy_sample_count", "target_roles", "evidence_ids", "public_sources"], "additionalProperties": false, "properties": {"state": {"const": "dated_vacancy_evidence"}, "geography": {"type": "string", "minLength": 1, "maxLength": 120}, "arrangement": {"enum": ["onsite", "hybrid", "remote", "flexible"]}, "research_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "vacancy_sample_count": {"type": "integer", "minimum": 1}, "target_roles": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/market_role"}}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E-[0-9]{3}$"}, "uniqueItems": true}, "public_sources": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/market_source"}}}}]},
    "market_role": {"type": "object", "required": ["title", "required_signals", "supported_signals", "gaps", "evidence_ids"], "additionalProperties": false, "properties": {"title": {"type": "string", "minLength": 1, "maxLength": 160}, "required_signals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 500}, "uniqueItems": true}, "supported_signals": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}, "uniqueItems": true}, "gaps": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}, "uniqueItems": true}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E-[0-9]{3}$"}, "uniqueItems": true}}},
    "market_source": {"type": "object", "required": ["url", "publisher", "document_title", "access_date"], "additionalProperties": false, "properties": {"url": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^https://"}, "publisher": {"type": "string", "minLength": 1, "maxLength": 120}, "document_title": {"type": "string", "minLength": 1, "maxLength": 240}, "access_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}},
    "privacy": {"type": "object", "required": ["private_report", "candidate_identity_included", "contact_data_included", "raw_profile_retained", "raw_private_analytics_included", "aggregate_analytics_included"], "additionalProperties": false, "properties": {"private_report": {"const": true}, "candidate_identity_included": {"const": false}, "contact_data_included": {"const": false}, "raw_profile_retained": {"const": false}, "raw_private_analytics_included": {"const": false}, "aggregate_analytics_included": {"type": "boolean"}}},
    "authorization": {"type": "object", "required": ["external_actions_authorized", "action_state"], "additionalProperties": false, "properties": {"external_actions_authorized": {"const": false}, "action_state": {"const": "not_executed"}}}
  }
}
